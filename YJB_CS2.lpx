#!name=养基宝去广告
#!desc=养基宝会员状态修改及广告接口屏蔽
#!author=自用
#!loon_version=3.5.1(978)

[Rewrite]
response if ${url} ~= /^https?://[^/]yangjibao.com/./account/vip_info(?:?.*)?$/ then response.json.jq(’.data.vip_label = true | .data.vip_expiry_date = “2099-12-31” | .data.is_pay = true’)
response if ${url} ~= /^https?://[^/]yangjibao.com/unify_ad(?:?.)?$/ then response.json.jq(’.data = null’)

[Mitm]
hostname = *.yangjibao.com