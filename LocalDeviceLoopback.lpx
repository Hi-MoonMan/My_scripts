#!name=本机服务回环_10.7.0.1
#!desc=为本机开发工具提供 LocalDevVPN 的回环机制(未关闭IPv6)：将发往 10.7.0.1 的数据包收进 TUN，交换源、目的 IP 后交回本机协议栈，不进入常规规则、不走代理、不转发出网。本插件未关闭整个 TUN 的 IPv6 VIF。本机服务仍需实际监听；插件不会创建服务或将目标地址映射为 127.0.0.1
#!author = MoonMan
#!icon=https://raw.githubusercontent.com/ios151/Rewrite/refs/heads/main/dev-loopback/modules/dev-loopback.png
#!loon_version=3.5.3(1007)

[General]
include-tun=10.7.0.1/32

[IP Rewrite]
10.7.0.1=reflect
