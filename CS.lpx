#!name= 签到脚本汇总_自用
#!desc= 按需开启相关任务，定时每日自动完成。获取Cookie后，及时关闭脚本以防异常。
#!author= @Sliverkiss @NobyDa @怎么肥事 @bb @MoonMan
#!homepage= https://github.com/Hi-MoonMan
#!icon= https://raw.githubusercontent.com/Hi-MoonMan/My_icons/refs/heads/Main/jb%20.png
#!date= 2026-09-13 20:00:00

[Argument]
# --- 小蚕惠生活 ---
xcbwc-token = switch, false, false, tag = [小蚕惠生活]获取Token, desc = 开启后打开App获取Cookie
xcbwc-task  = switch, false, false, tag = [小蚕惠生活]签到Task, desc = 开启后系统会自动后台签到
xcbwc-cron  = input, "0 30 7 * * *", tag = [小蚕惠生活]时间Cron, desc = 默认每天7点30分
notify = switch,true,tag=通知开关,desc=关闭后签到/领取VIP不推送通知

# --- 歪麦霸王餐 ---
wmbwc-token = switch, false, false, tag = [歪麦霸王餐]获取Token, desc = 开启后打开App获取Cookie
wmbwc-task  = switch, false, false, tag = [歪麦霸王餐]签到Task, desc = 开启后系统会自动后台签到
wmbwc-cron  = input, "0 40 7 * * *", tag = [歪麦霸王餐]时间Cron, desc = 默认每天7点40分
notify = switch,true,tag=通知开关,desc=关闭后签到/领取VIP不推送通知

[Script]

# --- 小蚕惠生活 Scripts ---
http-request ^https:\/\/gw\.xiaocantech\.com\/rpc script-path=https://gist.githubusercontent.com/Sliverkiss/27c601d97a3f8960b212e5cac5b6c470/raw/xcbwc.js, tag=小蚕惠生活获取Cookie, enabled={xcbwc-token}
cron {xcbwc-cron} script-path=https://gist.githubusercontent.com/Sliverkiss/27c601d97a3f8960b212e5cac5b6c470/raw/xcbwc.js, tag=小蚕惠生活定时任务, enabled={xcbwc-task}, argument=[{notify}]

# --- 歪麦霸王餐 Scripts ---
http-response ^https:\/\/wmapp-api\.waimaimingtang\.com\/api\/api\/v2\/user\/api_user_info_one script-path=https://gist.githubusercontent.com/Sliverkiss/49a9ffb2169a2becc33bf4fdbf6eb99a/raw/wmbwc.js, tag=歪麦霸王餐获取Cookie, enabled={wmbwc-token}
cron {wmbwc-cron} script-path=https://gist.githubusercontent.com/Sliverkiss/49a9ffb2169a2becc33bf4fdbf6eb99a/raw/wmbwc.js, tag=歪麦霸王餐定时任务, enabled={wmbwc-task}, argument=[{notify}]

[MITM]
hostname = gw.xiaocantech.com, wmapp-api.waimaimingtang.com